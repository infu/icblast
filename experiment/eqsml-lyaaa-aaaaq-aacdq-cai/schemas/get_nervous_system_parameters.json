        "type": "string",
        "description": "bigint as string"
      },
      "transaction_fee_e8s": {
        "type": "string",
        "description": "bigint as string"
      },
      "max_number_of_proposals_with_ballots": {
        "type": "string",
        "description": "bigint as string"
      },
      "max_age_bonus_percentage": {
        "type": "string",
        "description": "bigint as string"
