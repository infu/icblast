                    "followees": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "oneOf": [
                              {
                                "type": "string",
                                "description": "hex-encoded bytes"
                              },
                              {
                                "type": "array",
                                "items": {
                                  "type": "number"
                                },
                                "description": "byte array"
                              }
                            ]
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "id"
                        ]
                      }
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "followees"
                  ]
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "followees"
        ]
      },
      "max_dissolve_delay_seconds": {
        "type": "string",
