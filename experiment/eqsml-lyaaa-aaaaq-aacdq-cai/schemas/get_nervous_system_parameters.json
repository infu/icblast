        "type": "string",
        "description": "bigint as string"
      },
      "neuron_minimum_dissolve_delay_to_vote_seconds": {
        "type": "string",
        "description": "bigint as string"
      },
      "reject_cost_e8s": {
        "type": "string",
        "description": "bigint as string"
      },
