          "permissions": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "permissions"
        ]
      },
      "neuron_minimum_stake_e8s": {
        "type": "string",
        "description": "bigint as string"
      },
