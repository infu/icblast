{
  "name": "icblast",
  "version": "4.3.3",
  "description": "Blast: Explore Internet Computer canisters from your terminal.",
  "author": "infu",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infu/icblast.git"
  },
  "homepage": "https://github.com/infu/icblast#readme",
  "bugs": {
    "url": "https://github.com/infu/icblast/issues"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "blast": "bin/blast.js",
    "icblast": "bin/blast.js"
  },
  "exports": {
    ".": {
      "browser": "./lib/browser.js",
      "import": "./lib/index.js",
      "types": "./types/index.d.ts"
    },
    "./didc-wasm": {
      "types": "./types/didc-wasm.d.ts",
      "default": "./didc_wasm_pkg/didc_rust_bg.bin"
    },
    "./mcp": {
      "import": "./lib/mcp_server.js",
      "types": "./types/mcp_server.d.ts"
    }
  },
  "types": "types/index.d.ts",
  "files": [
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "bin",
    "didc_rust/Cargo.lock",
    "didc_rust/Cargo.toml",
    "didc_rust/src",
    "didc_rust/vendor",
    "lib",
    "didc_wasm_pkg",
    "README.md",
    "scripts/build-didc-wasm.mjs",
    "scripts/generate-rust-license-bundle.mjs",
    "scripts/verify-release-state.mjs",
    "third_party/licenses/rust",
    "types"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:didc": "node scripts/build-didc-wasm.mjs",
    "licenses:rust": "node scripts/generate-rust-license-bundle.mjs",
    "verify:didc": "node scripts/build-didc-wasm.mjs --check",
    "verify:licenses": "vitest run tests/package.spec.js --reporter=basic",
    "prepack": "npm run verify:didc && npm run verify:licenses",
    "prepublishOnly": "npm test && node scripts/verify-release-state.mjs",
    "start": "node bin/blast.js",
    "pack:local": "npm pack",
    "test": "vitest run --reporter=basic"
  },
  "devDependencies": {
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@dfinity/agent": "3.4.3",
    "@dfinity/auth-client": "3.4.3",
    "@dfinity/candid": "3.4.3",
    "@dfinity/cbor": "0.2.2",
    "@dfinity/identity": "3.4.3",
    "@dfinity/ledger-icrc": "4.1.0",
    "@dfinity/principal": "3.4.3",
    "@dfinity/utils": "3.2.0",
    "ajv": "^8.20.0",
    "fast-uri": "^3.1.5",
    "picocolors": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  }
}
